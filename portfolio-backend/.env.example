# ============================================================
# Portfolio Backend — Environment Configuration
# ============================================================
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/sachin_portfolio

# Google Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email Configuration (Nodemailer via Gmail App Password)
EMAIL_USER=sachinyaduvanshi553@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password_here
EMAIL_RECIPIENT=sachinyaduvanshi553@gmail.com

# Allowed CORS Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Admin Secret Key for Protected Routes
ADMIN_SECRET=sachin_portfolio_admin_secret_key_2026

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
